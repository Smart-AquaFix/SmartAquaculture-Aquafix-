#Rain-Triggered Pond Cover System
This module integrates a rain sensor, stepper motor, and LED indicators to automatically protect fish ponds from adverse weather.

How It Works
Rain Detection:

The rain sensor detects precipitation and sends a signal to the Arduino.

Automatic Pond Cover Activation:

The Arduino triggers a stepper motor (via a driver) to close the pond cover, shielding fish from excess rainwater (which can alter water quality).

Visual Indicators:

Green LED: Pond cover is open (normal conditions).

Red LED: Pond cover is closed (rain detected).

*Codes are below*


#include <Stepper.h>

// --- Pin Definitions ---
const int rainSensorPin = A0;     // Analog input from rain sensor
const int greenLedPin = 7;        // Green LED pin (dry)
const int redLedPin = 6;          // Red LED pin (rain)

const int IN1 = 8;                // Stepper motor control pin IN1
const int IN2 = 9;                // Stepper motor control pin IN2
const int IN3 = 10;               // Stepper motor control pin IN3
const int IN4 = 11;               // Stepper motor control pin IN4

// --- Motor Settings ---
const int stepsPerRevolution = 2048;                   // Full revolution for 28BYJ-48
const int stepsFor90Degrees = 3 * stepsPerRevolution / 4;  // Steps for 270-degree movement
const int motorSpeed = 10;                             // Motor speed (RPM)

// --- Sensor Threshold ---
const int rainThreshold = 650;  // Sensor value below this means rain detected

// --- Variables to track state ---
bool isRaining = false;         // Tracks current rain status
bool motorMoved = false;        // Tracks if motor has moved due to rain

// --- Initialize stepper motor ---
Stepper myStepper(stepsPerRevolution, IN1, IN3, IN2, IN4);

void setup() {
  // Initialize LED pins
  pinMode(greenLedPin, OUTPUT);
  pinMode(redLedPin, OUTPUT);

  // Set initial LED states
  digitalWrite(greenLedPin, HIGH);  // Green ON (dry)
  digitalWrite(redLedPin, LOW);     // Red OFF

  // Set motor speed
  myStepper.setSpeed(motorSpeed);

  // Start Serial Monitor for debugging
  Serial.begin(9600);
  Serial.println("Rain Detection System Initialized for RAS Tank.\n");
}

void loop() {
  int sensorValue = analogRead(rainSensorPin);

  // Print sensor value to serial monitor
  Serial.print("Rain Sensor Value: \n");
  Serial.println(sensorValue);

  // If rain is detected
  if (sensorValue < rainThreshold) {
    if (!isRaining) {
      Serial.println("\nRain detected! Activating motor...\n");

      // Update status
      isRaining = true;
      motorMoved = true;

      // Turn LEDs
      digitalWrite(greenLedPin, LOW);   // Green OFF
      digitalWrite(redLedPin, HIGH);    // Red ON

      // Rotate motor 90 degrees clockwise
      myStepper.step(stepsFor90Degrees);
    }
  }
  // If no rain is detected
  else {
    if (isRaining) {
      Serial.println("Dry condition detected. Returning motor...\n");

      // Update status
      isRaining = false;

      // Turn LEDs
      digitalWrite(redLedPin, LOW);     // Red OFF
      digitalWrite(greenLedPin, HIGH);  // Green ON

      // Rotate motor 90 degrees counterclockwise (back to original)
      if (motorMoved) {
        myStepper.step(-stepsFor90Degrees);
        motorMoved = false;
      }
    }
  }

  delay(3000); // Delay to avoid sensor flickering (adjust as needed)
