void loop() {
  static unsigned long lastSensorReadTime = 0;          // Last time sensors were read
  const unsigned long sensorInterval = 5000;            // Interval between sensor readings

  if (millis() - lastSensorReadTime >= sensorInterval && pumpState == IDLE) {
    lastSensorReadTime = millis();                      // Update last read time

    // === pH Sensor Reading ===
    int ph_raw[10];
    for (int i = 0; i < 10; i++) {
      ph_raw[i] = analogRead(PH_SENSOR_PIN);            // Read pH sensor 10 times
      delay(20);
    }

    // Sort readings
    for (int i = 0; i < 9; i++) {
      for (int j = i + 1; j < 10; j++) {
        if (ph_raw[i] > ph_raw[j]) {
          int temp = ph_raw[i];
          ph_raw[i] = ph_raw[j];
          ph_raw[j] = temp;
        }
      }
    }

    // Average the middle 6 readings
    unsigned long avg_ph_val = 0;
    for (int i = 2; i < 8; i++) {
      avg_ph_val += ph_raw[i];
    }

    float ph_voltage = (avg_ph_val * 3.3f / 4095.0f) / 6.0f;        // Convert average analog value to voltage
    float pH = -5.70f * ph_voltage + ph_calibration;               // Convert voltage to pH value
    pH = constrain(pH, 0.0f, 14.0f);                                // Constrain pH between 0 and 14

    // === Temperature Sensor Reading ===
    tempSensor.requestTemperatures();                             // Request temperature
    float tempC = tempSensor.getTempCByIndex(0);                  // Get temperature from sensor
    if (tempC != DEVICE_DISCONNECTED_C) {
      env_temperature = tempC;                                    // Update environment temperature
    }

    // === Turbidity Sensor Reading ===
    int turbidity_raw = analogRead(TURBIDITY_PIN);                // Read turbidity analog value
    float turbidity_voltage = turbidity_raw * (3.3f / 4095.0f);   // Convert to voltage
    float turbidity_ntu = -1120.4f * sq(turbidity_voltage) + 5742.3f * turbidity_voltage - 4352.9f;  // Convert to NTU
    turbidity_ntu = max(0.0f, turbidity_ntu);                     // Ensure turbidity is non-negative

    // === MQ135 Sensor Reading ===
    float nh3_ppm = mq135_sensor.getCorrectedPPM(env_temperature, env_humidity); // Get corrected ammonia level

    // === Calculate Dissolved Oxygen ===
    float dissolved_oxygen = calculateDO(nh3_ppm, turbidity_ntu, env_temperature); // Compute DO

    // === Display Sensor Readings on Serial Monitor ===
    Serial.println("\n========== Analog Sensor Reading ==========\n");

    Serial.print("  pH Value: ");
    Serial.print(pH, 2);
    if (pH < 4.0f)
      Serial.println(" Water shows more Acidic content");
    else if (pH < 8.0f)
      Serial.println(" Moderate pH content (Trout Fish can Adjust and survive)");
    else
      Serial.println(" Water shows more Alkaline content\n");

    Serial.print("  Temperature: ");
    Serial.print(env_temperature, 2);
    Serial.println(" °C\n");

    Serial.print("  Turbidity: ");
    Serial.print(turbidity_ntu, 2);
    Serial.println(" NTU");
    if (turbidity_ntu > 2500.0f)
      Serial.println(" Trout Fish Can Survive (Normal Cloudiness)");
    else
      Serial.println(" Trout Fish Can't Survive (High Cloudiness)\n");

    Serial.print("  Ammonia Gas (NH3): ");
    Serial.print(nh3_ppm, 2);
    Serial.println(" ppm\n");
    if (nh3_ppm < 6000.0f)
      Serial.println("Low Ammonia Level (Safe for Trout Fish)");
    else
      Serial.println("High Ammonia Level (Dangerous for Trout Fish)\n");

