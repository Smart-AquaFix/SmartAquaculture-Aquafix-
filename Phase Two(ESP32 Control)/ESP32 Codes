
#include <WiFi.h>                      // Include library for WiFi communication
#include <HTTPClient.h>                // Include library to send HTTP requests
#include <OneWire.h>                   // Include library for OneWire communication (used by temperature sensor)
#include <DallasTemperature.h>         // Include library to read temperature from Dallas temperature sensors
#include <MQ135.h>                     // Include library to read from MQ135 gas sensor

// --- Pin Assignments (ESP32 GPIO) ---
#define PH_SENSOR_PIN 34               // Analog pin for pH sensor
#define MQ135_PIN 35                   // Analog pin for MQ135 sensor (ammonia)
#define TURBIDITY_PIN 32              // Analog pin for turbidity sensor
#define TEMP_SENSOR_PIN 4             // Digital pin for DS18B20 temperature sensor
#define RELAY_PIN 16                  // Digital pin to control pump 1 (Relay)
#define RELAY_PIN_2 2                 // Digital pin to control pump 2 (Relay)

// --- WiFi Credentials ---
const char* ssid = "Elect & Mech Wireless AP";  // WiFi SSID
const char* password = "";                      // WiFi password (empty in this case)
const char* serverUrl = "https://aquafix-backend.onrender.com/api/sensor-data"; // Server URL to post data

// --- Calibration and Environmental Values ---
float ph_calibration = 20.94;        // Calibration offset for pH sensor
float env_temperature = 25.0;        // Default ambient temperature
float env_humidity = 50.0;           // Default ambient humidity

// --- Sensor Objects ---
OneWire oneWire(TEMP_SENSOR_PIN);              // OneWire bus instance
DallasTemperature tempSensor(&oneWire);        // Dallas temperature sensor instance
MQ135 mq135_sensor(MQ135_PIN);                 // MQ135 gas sensor instance

// --- Pump State Logic ---
enum PumpState { IDLE, PUMP1_RUNNING, PUMP2_RUNNING };  // Enum for pump state
PumpState pumpState = IDLE;                            // Initial pump state

unsigned long pump1StartTime = 0;      // Timestamp for pump 1 start
unsigned long pump2StartTime = 0;      // Timestamp for pump 2 start

// --- Function to Calculate Dissolved Oxygen ---
float calculateDO(float ammonia, float turbidity, float temperature) {
  float baseDO = 8.0f;                                  // Base DO level
  float tempEffect = 0.5f * (25.0f - temperature);      // Effect of temperature on DO
  float ammoniaImpact = min((float)(ammonia * 0.5f), 3.0f);  // Ammonia impact limited to max 3
  float turbidityImpact = min((float)(turbidity * 0.02f), 2.0f); // Turbidity impact limited to max 2
  float calculatedDO = max(0.0f, baseDO - tempEffect - ammoniaImpact - turbidityImpact); // Final DO
  return calculatedDO;
}

// --- Function to Send Sensor Data to the Server ---
void sendSensorData(float pH, float ammonia, float turbidity, float temperature, float dissolvedOxygen) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(serverUrl);                                 // Begin HTTP request
    http.addHeader("Content-Type", "application/json");   // Set content-type header

    // Create JSON payload
    String payload = String("{\"pH\":") + pH + 
                     ",\"ammonia\":" + ammonia + 
                     ",\"turbidity\":" + turbidity + 
                     ",\"temperature\":" + temperature +
                     ",\"dissolvedOxygen\":" + dissolvedOxygen + "}";

    int httpCode = http.POST(payload);                     // Send HTTP POST
    if (httpCode > 0) {
      Serial.printf("Data sent! HTTP code: %d\n", httpCode);
    } else {
      Serial.printf("HTTP Error: %s\n", http.errorToString(httpCode).c_str());
    }
    http.end();
  } else {
    Serial.println("WiFi not connected. Data not sent.");
  }
}

