Serial.print(" Dissolved Oxygen Level: ");
    Serial.print(dissolved_oxygen, 2);
    Serial.println(" mg/L");

    // === Send Data to Server ===
    sendSensorData(pH, nh3_ppm, turbidity_ntu, env_temperature, dissolved_oxygen);

    // === Relay Control Condition ===
    bool isTurbid = turbidity_ntu < 3000.0f;
    bool isNH3Hazardous = nh3_ppm > 6000.0f;

    Serial.print("\nIs Turbidity Acceptable? ");
    Serial.println(isTurbid ? "Yes" : "No");

    Serial.print("\nIs NH3 Level Hazardous? ");
    Serial.println(isNH3Hazardous ? "Yes" : "No");

    if (isTurbid && isNH3Hazardous) {
      digitalWrite(RELAY_PIN, HIGH);                // Turn on pump 1
      pump1StartTime = millis();                    // Record start time
      pumpState = PUMP1_RUNNING;                    // Update state
      Serial.println("\n>>> Pump_1: Water Changing in Recirculating Aquaculture System (RAS) Tank...");
    } else {
      digitalWrite(RELAY_PIN, LOW);                 // Turn off both pumps
      digitalWrite(RELAY_PIN_2, LOW);
      Serial.println("\n>>> All Pumps OFF <<<");
    }
  }

  // === Pump 1 runs for 30 seconds ===
  if (pumpState == PUMP1_RUNNING && millis() - pump1StartTime >= 30000) {
    digitalWrite(RELAY_PIN, LOW);                 // Stop pump 1
    digitalWrite(RELAY_PIN_2, HIGH);              // Start pump 2
    pump2StartTime = millis();                    // Record pump 2 start time
    pumpState = PUMP2_RUNNING;                    // Update state
    Serial.println(">>> Stopping Pump_1 and starting Pump_2 (Water changing)");
  }

  // === Pump 2 runs for 20 seconds ===
  if (pumpState == PUMP2_RUNNING && millis() - pump2StartTime >= 20000) {
    digitalWrite(RELAY_PIN_2, LOW);              // Stop pump 2
    pumpState = IDLE;                             // Reset state to IDLE
    Serial.println(">>> Pump_2 OFF — RAS Tank Water Changed — Restarting Cycle <<<\n");
  }
}
